{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/_tests/**",
    "**/__fixtures__/**",
    "**/*.spec.ts",
    "**/*.spec.js",
    "**/*.config.ts"
  ]
}
