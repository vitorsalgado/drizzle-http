{
  "name": "@drizzle-http/core",
  "version": "4.0.0",
  "description": "Drizzle-Http core module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc --build --force tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts packages/drizzle-core",
    "test:e2e:prepare": "npx playwright install-deps && npx playwright install",
    "test:e2e": "playwright test --config builtin/fetch/playwright.config.ts",
    "webpack:server-dev": "webpack serve --config builtin/fetch/build/webpack.config.cjs",
    "lint": "eslint \"**/*.ts\" --fix",
    "prettier": "prettier './**' --write --ignore-unknown",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Vitor Hugo Salgado",
    "url": "https://github.com/vitorsalgado"
  },
  "license": "MIT",
  "homepage": "https://github.com/vitorsalgado/drizzle-http",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorsalgado/drizzle-http.git",
    "directory": "packages/drizzle-core"
  },
  "bugs": {
    "url": "https://github.com/vitorsalgado/drizzle-http/issues"
  },
  "keywords": [
    "drizzle-http",
    "http",
    "api",
    "http",
    "http client",
    "rest",
    "api",
    "node",
    "typescript",
    "decorator",
    "easy",
    "annotations"
  ],
  "devDependencies": {
    "@drizzle-http/test-utils": "^3.1.0",
    "@playwright/test": "^1.17.1"
  },
  "type": "module"
}
