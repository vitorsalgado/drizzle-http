{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "lib": ["ES2022", "ESNext.decorators", "DOM", "DOM.Iterable"],
    "paths": {
      "@drizzle-http/core": ["./index.ts"]
    }
  },
  "references": [
    {
      "path": "../../internal/test-utils"
    }
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/_tests/**",
    "**/__fixtures__/**",
    "**/*.test.ts",
    "**/*.test.js",
    "**/*.config.ts"
  ]
}
