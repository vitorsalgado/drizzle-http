{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./http",
    "outDir": "./http",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "references": [
    {
      "path": "../../packages/drizzle-core"
    },
    {
      "path": "../../packages/drizzle-undici"
    },
    {
      "path": "../../packages/drizzle-logging-interceptor"
    }
  ],
  "include": [
    "http/"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
