{
  "name": "@drizzle-http/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:failures": "vitest run --reporter=verbose",
    "prepare": "husky install",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --clean && tsc --build --force",
    "lint": "eslint \"**/*.{ts,mjs,js}\"",
    "lint:fix": "eslint \"**/*.{ts,mjs,js}\" --fix",
    "fmt": "prettier 'packages/**' '_examples/**' '_benchmarks/**' --write --ignore-unknown",
    "fmt:check": "npm run fmt -- --check",
    "release": "node scripts/packaging.js publish",
    "clean": "tsc --build --clean",
    "benchmark": "npm run build --workspace @drizzle-http/benchmarks && concurrently -k --kill-others-on-fail -s first \"npm run server --workspace @drizzle-http/benchmarks\" \"node -e \\\"setTimeout(() => {}, 1000)\\\" && npm run bench:post --workspace @drizzle-http/benchmarks\"",
    "benchmark:streaming": "npm run build --workspace @drizzle-http/benchmarks && concurrently -k --kill-others-on-fail -s first \"npm run server --workspace @drizzle-http/benchmarks\" \"node -e \\\"setTimeout(() => {}, 1000)\\\" && npm run bench:streaming --workspace @drizzle-http/benchmarks\"",
    "postinstall": "husky install",
    "release:prepare": "node scripts/packaging.js prepare",
    "release:publish": "node scripts/packaging.js publish"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorsalgado/drizzle-http.git"
  },
  "author": {
    "name": "Vitor Hugo Salgado",
    "url": "https://github.com/vitorsalgado"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vitorsalgado/drizzle-http/issues"
  },
  "homepage": "https://github.com/vitorsalgado/drizzle-http",
  "workspaces": [
    "_benchmarks",
    "internal/*",
    "packages/*",
    "_examples/*"
  ],
  "keywords": [
    "http",
    "http client",
    "rest",
    "api",
    "undici",
    "node",
    "typescript",
    "decorators",
    "easy",
    "annotations"
  ],
  "devDependencies": {
    "@babel/cli": "^7.16.7",
    "@babel/core": "^7.16.7",
    "@babel/plugin-proposal-class-properties": "^7.16.7",
    "@babel/plugin-proposal-decorators": "^7.16.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.16.7",
    "@babel/plugin-proposal-object-rest-spread": "^7.16.7",
    "@babel/plugin-proposal-optional-chaining": "^7.16.7",
    "@babel/plugin-transform-runtime": "^7.16.7",
    "@babel/preset-env": "^7.16.7",
    "@babel/runtime": "^7.16.7",
    "@commitlint/cli": "^16.0.1",
    "@commitlint/config-conventional": "^16.0.0",
    "@rollup/plugin-babel": "^5.3.0",
    "@swc/core": "^1.15.40",
    "@types/benchmark": "^2.1.1",
    "@types/node": "^22.10.0",
    "@types/node-fetch": "^3.0.3",
    "@types/opossum": "^6.2.0",
    "@types/pino": "^7.0.5",
    "@types/puppeteer": "^5.4.4",
    "@types/superagent": "^4.1.14",
    "@types/supertest": "^2.0.11",
    "@vitest/coverage-v8": "^3.0.5",
    "babel-loader": "^8.2.3",
    "babel-plugin-parameter-decorator": "^1.0.16",
    "clean-webpack-plugin": "^4.0.0",
    "codecov": "^3.8.3",
    "commander": "^8.3.0",
    "concurrently": "^7.0.0",
    "dotenv": "^14.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-tsdoc": "^0.4.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.48.0",
    "fastify": "^3.25.3",
    "fastify-formbody": "^5.2.0",
    "fastify-multipart": "^5.2.1",
    "fs-extra": "^10.0.0",
    "globby": "^12.0.2",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^7.0.4",
    "pino": "^7.6.2",
    "pino-pretty": "^7.3.0",
    "pinst": "^2.1.6",
    "prettier": "^2.5.1",
    "rollup": "^2.62.0",
    "ts-loader": "^9.2.6",
    "ts-node": "10.4.0",
    "typescript": "^5.7.2",
    "undici": "^4.12.1",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.5",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.7.2"
  }
}
